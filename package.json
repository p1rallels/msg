{
	"name": "msg-cli",
	"version": "0.1.0",
	"private": true,
	"description": "Agent-to-agent messaging for pi sessions: a pi extension (msg_list, msg_send) over one maildir store",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && bun test",
		"e2e": "bun e2e/run.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@types/bun": "^1.4.3",
		"@types/node": "22",
		"typebox": "1.3.27",
		"typescript": "5"
	}
}
